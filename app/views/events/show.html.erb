<h1><%= @event.title %></h1>

<p><%= @event.description %></p>

<dl>
  <dt>会場</dt>
  <dd><%= @event.venue %></dd>
  <dt>日時</dt>
  <dd><%= @event.starts_at.strftime("%Y年%-m月%-d日 %H:%M") %></dd>
  <dt>定員</dt>
  <dd>定員 <%= @event.capacity %>人（残り <%= @event.remaining_seats %>席）</dd>
  <dt>料金</dt>
  <dd><%= number_with_delimiter(@event.price) %>円</dd>
</dl>

<h2>予約する</h2>

<%= form_with model: [@event, @reservation] do |form| %>
  <%= render "shared/errors", record: @reservation %>

  <p>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </p>
  <p>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </p>
  <p>
    <%= form.label :quantity %>
    <%= form.number_field :quantity, min: 1, value: @reservation.quantity || 1 %>人
  </p>

  <%= form.submit "予約する" %>
<% end %>

<%= link_to "イベント一覧へ戻る", events_path %>
